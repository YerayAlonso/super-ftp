{
  "name": "super-ftp",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:manifest": "node --test scripts/create-update-manifest.test.mjs",
    "test:ui": "playwright test",
    "test:native": "node scripts/native-smoke.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "verify": "npm run check && npm run test && npm run test:manifest && npm run build",
    "format": "prettier --write src e2e scripts package.json vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json svelte.config.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@lucide/svelte": "^1.67.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.10.0",
    "@playwright/test": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
